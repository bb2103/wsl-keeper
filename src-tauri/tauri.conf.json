{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WSL Keeper",
  "version": "0.1.0",
  "identifier": "com.lea.wsl-keeper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WSL Keeper",
        "width": 920,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "visible": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
